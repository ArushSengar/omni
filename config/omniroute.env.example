# =============================================================================
# OmniRoute Production Environment Configuration Template
# Place this at: ~/.omniroute/.env or /usr/lib/node_modules/omniroute/.env
# =============================================================================

# Server Bind Address & Port
HOSTNAME=0.0.0.0
PORT=20128

# Encryption Key for SQLite Provider Credentials (AES-256-GCM)
# Generate with: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=94cdc28ee5c868d60e5e36b6b6c895a0bb90dfc6eefee24e964ccfc8656268d6

# Browser Automation Paths (For Cloudflare Playground & Web Providers)
CLOUDFLARE_PLAYGROUND_CHROME_PATH=/usr/bin/chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Security & CORS
OMNIROUTE_ENABLE_CORS=true
OMNIROUTE_ALLOW_LAN_ACCESS=true

# Cache & Telemetry
OMNIROUTE_CACHE_ENABLED=true
OMNIROUTE_LOG_LEVEL=info
OMNIROUTE_DEFAULT_FETCH_TIMEOUT_MS=60000

