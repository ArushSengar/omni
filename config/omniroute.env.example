# ==============================================================================
# OmniRoute Environment Template - Optimized for Raspberry Pi 4 (ARM64)
# ==============================================================================

# Core Encryption & Storage
STORAGE_ENCRYPTION_KEY=YOUR_64_CHAR_HEX_ENCRYPTION_KEY_HERE
STORAGE_ENCRYPTION_KEY_VERSION=v1

# Network & Host Binding
PORT=20128
HOSTNAME=0.0.0.0
APP_BIND_HOST=0.0.0.0
BASE_URL=http://localhost:20128
KEEP_ALIVE_TIMEOUT=65000

# Security & Authentication
# CRITICAL: Forces Bearer token authentication on all /v1/* inference endpoints
REQUIRE_API_KEY=true
ALLOW_API_KEY_REVEAL=true
AUTH_COOKIE_SECURE=true

# Raspberry Pi 4 Performance Tuning
OMNIROUTE_READY_TIMEOUT_MS=120000
OMNIROUTE_MEMORY_MB=1024
OMNI_COMPRESSION_WORKERS=1
OMNI_COMPRESSION_WORKER_TIMEOUT_MS=60000
OMNI_COMPRESSION_WORKER_IDLE_MS=30000

# Cache & Reasoning Optimization
SEMANTIC_CACHE_TTL_MS=1800000
PROMPT_CACHE_TTL_MS=300000
CREDENTIAL_HEALTH_CACHE_TTL=300000

# Browser Automation & Playwright Paths
CLOUDFLARE_PLAYGROUND_CHROME_PATH=/usr/bin/chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Logging & Observability
APP_LOG_TO_FILE=true
APP_LOG_MAX_FILES=5
APP_LOG_MAX_FILE_SIZE=10485760
